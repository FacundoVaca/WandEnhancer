# satellite dish companion tile: one 4 mm triangle bound inside the pole; draws nothing visible, only stops PZ3D drawing its "example" photo box
# Z up, tile units, 1 triangles; PZ3D draws pack models double-sided.
mtllib stub-rp.mtl
usemtl atlas
v -0.0020 -0.0010 0.0000
v 0.0020 -0.0010 0.0000
v 0.0000 0.0020 0.0000
vt 0.125000 0.500000
vn 0.0000 0.0000 1.0000
f 1/1/1 2/1/1 3/1/1

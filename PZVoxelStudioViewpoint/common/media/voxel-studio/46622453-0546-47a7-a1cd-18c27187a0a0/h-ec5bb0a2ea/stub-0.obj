# Grey Chandelier companion piece lighting_indoor_03_0: one 4 mm triangle, bound inside the chandelier rod above
# the ceiling rose. It draws nothing visible; it only stops PZ3D drawing its "example" photo box for this sprite.
mtllib stub-0-rp.mtl
usemtl atlas
v -0.002 -0.001 0.0
v 0.002 -0.001 0.0
v 0.0 0.002 0.0
vt 0.125000 0.500000
vn 0 0 1
f 1/1/1 2/1/1 3/1/1
